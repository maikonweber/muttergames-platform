{
  "name": "muttergames-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @muttergames/web dev",
    "dev:api": "pnpm --filter @muttergames/api start:dev",
    "dev:fallen-gs": "pnpm --filter @muttergames/fallen-game-server start:dev",
    "build:launcher": "dotnet publish apps/launcher/MutterGames.Launcher.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o outputs/launcher/win-x64",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "packageManager": "pnpm@11.15.1"
}
