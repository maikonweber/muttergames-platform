{
  "name": "muttercoin-solana",
  "version": "0.1.0",
  "private": true,
  "description": "MutterCoin ($MUTTER) — Token-2022 mint + sandbox tooling",
  "type": "module",
  "scripts": {
    "sandbox:setup": "tsx scripts/sandbox-setup.ts",
    "sandbox:create-mint": "tsx scripts/create-mint.ts",
    "sandbox:mint": "tsx scripts/mint-tokens.ts",
    "sandbox:info": "tsx scripts/mint-info.ts",
    "sandbox:update-uri": "tsx scripts/update-metadata-uri.ts",
    "sandbox:all": "tsx scripts/sandbox-all.ts",
    "sandbox:validator": "docker start mutter-solana-sandbox 2>nul || docker run -d --name mutter-solana-sandbox -p 8899:8899 -p 8900:8900 solanalabs/solana:v1.18.26 solana-test-validator --bind-address 0.0.0.0 --rpc-port 8899 --ledger /tmp/ledger --reset --quiet"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.98.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.5.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
