[node name="TrayEnabled" type="CheckButton" parent="Margin/Content/SettingsPanel/SettingsContent"]
unique_name_in_owner = true
layout_mode = 2
text = "Minimizar para a bandeja do Windows ao fechar"

[node name="ClickThrough" type="CheckButton" parent="Margin/Content/SettingsPanel/SettingsContent"]
unique_name_in_owner = true
layout_mode = 2
text = "Clique através (experimental)"

[node name="MonitorRow" type="HBoxContainer" parent="Margin/Content/SettingsPanel/SettingsContent"]
layout_mode = 2

[node name="MonitorLabel" type="Label" parent="Margin/Content/SettingsPanel/SettingsContent/MonitorRow"]
