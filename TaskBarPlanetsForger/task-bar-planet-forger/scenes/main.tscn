[node name="Opacity" type="HSlider" parent="Margin/Content/SettingsPanel/SettingsContent"]
unique_name_in_owner = true
layout_mode = 2
min_value = 0.45
max_value = 1.0
step = 0.05

[node name="DesktopSeparator" type="HSeparator" parent="Margin/Content/SettingsPanel/SettingsContent"]
layout_mode = 2

[node name="DesktopTitle" type="Label" parent="Margin/Content/SettingsPanel/SettingsContent"]
layout_mode = 2
