[node name="AlwaysOnTop" type="CheckButton" parent="Margin/Content/SettingsPanel/SettingsContent"]
unique_name_in_owner = true
layout_mode = 2
text = "Sempre no topo"

[node name="CloseMinimizes" type="CheckButton" parent="Margin/Content/SettingsPanel/SettingsContent"]
unique_name_in_owner = true
layout_mode = 2
text = "Fechar minimiza a janela"

[node name="LargeText" type="CheckButton" parent="Margin/Content/SettingsPanel/SettingsContent"]
unique_name_in_owner = true
layout_mode = 2
text = "Texto ampliado"

[node name="RateLabel" type="Label" parent="Margin/Content/SettingsPanel/SettingsContent"]
layout_mode = 2
text = "Velocidade da simulação"

[node name="UpdateRate" type="HSlider" parent="Margin/Content/SettingsPanel/SettingsContent"]
unique_name_in_owner = true
layout_mode = 2
