[node name="AnchorRow" type="HBoxContainer" parent="Margin/Content/SettingsPanel/SettingsContent"]
layout_mode = 2

[node name="AnchorLabel" type="Label" parent="Margin/Content/SettingsPanel/SettingsContent/AnchorRow"]
