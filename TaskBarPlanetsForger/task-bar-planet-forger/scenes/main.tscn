[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.85, 0.93, 1, 1)
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.055, 0.11, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 18.0
offset_top = 14.0
offset_right = -18.0
offset_bottom = -14.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Margin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Content/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 24
text = "✦ TASKBAR PLANETS FORGER"

[node name="Compact" type="Button" parent="Margin/Content/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Modo compacto"

[node name="Pause" type="Button" parent="Margin/Content/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Pausar"

[node name="Save" type="Button" parent="Margin/Content/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Salvar"

[node name="Settings" type="Button" parent="Margin/Content/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Configurações"

[node name="Resources" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[node name="TutorialBox" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Tutorial" type="Label" parent="Margin/Content/TutorialBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.95, 0.78, 0.38, 1)

[node name="DismissTutorial" type="Button" parent="Margin/Content/TutorialBox"]
layout_mode = 2
text = "Ocultar tutorial"

[node name="Actions" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2

[node name="CreateAsteroid" type="Button" parent="Margin/Content/Actions"]
layout_mode = 2
text = "Criar asteroide (15 Materia)"

[node name="CollectWater" type="Button" parent="Margin/Content/Actions"]
layout_mode = 2
text = "Capturar água (8 Energia)"

[node name="Research" type="Button" parent="Margin/Content/Actions"]
layout_mode = 2
text = "Pesquisar (8 Biomassa)"

[node name="Asteroids" type="Label" parent="Margin/Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
vertical_alignment = 1

[node name="Prestige" type="Button" parent="Margin/Content/Actions"]
layout_mode = 2
text = "Supernova / Prestigio"

[node name="Separator" type="HSeparator" parent="Margin/Content"]
layout_mode = 2

[node name="Subtitle" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Sistema solar"

[node name="Orbits" type="VBoxContainer" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="EventPanel" type="PanelContainer" parent="Margin/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="EventContent" type="VBoxContainer" parent="Margin/Content/EventPanel"]
layout_mode = 2

[node name="EventText" type="Label" parent="Margin/Content/EventPanel/EventContent"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[node name="Choices" type="HBoxContainer" parent="Margin/Content/EventPanel/EventContent"]
unique_name_in_owner = true
layout_mode = 2

[node name="SettingsPanel" type="PanelContainer" parent="Margin/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="SettingsContent" type="VBoxContainer" parent="Margin/Content/SettingsPanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="SettingsTitle" type="Label" parent="Margin/Content/SettingsPanel/SettingsContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
