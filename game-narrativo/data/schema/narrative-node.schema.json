{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muttergames.local/conexoes/narrative-node.schema.json",
  "title": "NarrativeNode",
  "type": "object",
  "required": ["id", "speaker", "text"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^EP[0-9]{2}_SC[0-9]{2}_N[0-9]{3}$" },
    "speaker": { "type": "string" },
    "text": { "type": "string", "minLength": 1 },
    "expression": { "type": "string", "default": "idle" },
    "location": { "type": "string" },
    "music": { "type": "string" },
    "conditions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "choices": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "text", "next"],
        "properties": {
          "id": { "type": "string", "pattern": "^EP[0-9]{2}_SC[0-9]{2}_C[0-9]{2}$" },
          "text": { "type": "string" },
          "conditions": { "type": "array" },
          "effects": { "type": "array" },
          "next": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "effects": { "type": "array" },
    "next": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
