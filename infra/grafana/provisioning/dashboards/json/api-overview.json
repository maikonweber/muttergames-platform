{
  "title": "MutterGames API Overview",
  "uid": "muttergames-api",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests por segundo",
      "id": 1,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(muttergames_http_requests_total[5m])) by (route)", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries",
      "title": "Latencia p95",
      "id": 2,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(muttergames_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries",
      "title": "Erros 5xx",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [{ "expr": "sum(rate(muttergames_http_requests_total{status=~\"5..\"}[5m])) by (route)", "legendFormat": "{{route}}" }]
    },
    {
      "type": "logs",
      "title": "Logs da API",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service_name=\"muttergames-api\"}" }]
    }
  ]
}
